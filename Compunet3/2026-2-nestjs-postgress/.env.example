# Copia este archivo como .env y ajusta los valores a tu entorno:
#   cp .env.example .env
#
# El archivo .env nunca se sube al repositorio.

# Base de datos PostgreSQL (docker-compose usa estas mismas variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compunet3
DB_USERNAME=postgres
DB_PASSWORD=tu_password

# Puerto HTTP de la aplicación
PORT=9000

# Secreto para firmar los JWT (no usar en producción)
JWT_SECRET=un_secreto_para_desarrollo
